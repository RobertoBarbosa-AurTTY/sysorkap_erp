<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include("../../partials/head") %>
</head>
<body class="relative flex min-h-dvh flex-col overflow-hidden bg-slate-50">
  <div class="pointer-events-none absolute -left-24 -top-24 h-64 w-64 rounded-full bg-indigo-200/40 blur-3xl sm:-left-32 sm:-top-32 sm:h-96 sm:w-96"></div>
  <div class="pointer-events-none absolute -bottom-28 -right-20 h-72 w-72 rounded-full bg-violet-200/30 blur-3xl sm:-bottom-40 sm:-right-24 sm:h-[28rem] sm:w-[28rem]"></div>

  <main class="relative z-10 flex flex-1 items-center justify-center px-4 py-8 sm:py-10">
    <div class="w-full max-w-sm">
      <header class="mb-8 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Sysorkap</h1>
        <p class="mt-1.5 text-sm text-slate-500">Bem-vindo de volta. Entre para continuar.</p>
      </header>

      <div id="erro" class="hidden mb-5 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-600"></div>

      <form id="form" class="space-y-4 sm:space-y-5" novalidate>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">Email</label>
          <input id="email" type="email" name="email" autocomplete="email" autofocus placeholder="voce@empresa.com"
                 class="w-full rounded-xl border border-slate-300/80 bg-white px-4 py-3 text-base text-slate-800 placeholder:text-slate-400 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 sm:text-sm">
        </div>

        <div>
          <label for="senha" class="mb-1.5 block text-sm font-medium text-slate-700">Senha</label>
          <div class="relative">
            <input id="senha" type="password" name="senha" autocomplete="current-password" placeholder="Sua senha"
                   class="w-full rounded-xl border border-slate-300/80 bg-white px-4 py-3 pr-12 text-base text-slate-800 placeholder:text-slate-400 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50 sm:text-sm">
            <button type="button" id="toggle-senha" aria-label="Mostrar senha"
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600">
              <svg id="icone-olho" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <svg id="icone-olho-cortado" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
              </svg>
            </button>
          </div>
        </div>

        <label class="flex cursor-pointer select-none items-center gap-2.5 text-sm text-slate-600">
          <input id="lembrar" type="checkbox" name="lembrar" class="h-4 w-4 rounded border-slate-300 accent-primary">
          Lembrar de mim por 30 dias
        </label>

        <button id="botao" type="submit"
                class="w-full rounded-xl bg-primary py-3 text-sm font-semibold text-white shadow-lg shadow-primary/30 transition hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary/50 focus:ring-offset-2 active:translate-y-px disabled:pointer-events-none disabled:opacity-60">
          Entrar
        </button>
      </form>
    </div>
  </main>

  <footer class="relative z-10 pb-6 text-center text-xs text-slate-400">
    Sysorkap &middot; Gestao de estoque
  </footer>

<script>
  const form = document.getElementById("form");
  const email = document.getElementById("email");
  const senha = document.getElementById("senha");
  const lembrar = document.getElementById("lembrar");
  const erro = document.getElementById("erro");
  const botao = document.getElementById("botao");
  const iconeOlho = document.getElementById("icone-olho");
  const iconeOlhoCortado = document.getElementById("icone-olho-cortado");

  document.getElementById("toggle-senha").addEventListener("click", () => {
    const visivel = senha.type === "text";
    senha.type = visivel ? "password" : "text";
    iconeOlho.classList.toggle("hidden", !visivel);
    iconeOlhoCortado.classList.toggle("hidden", visivel);
  });

  function mostrarErro(mensagem) {
    erro.textContent = mensagem;
    erro.classList.remove("hidden");
  }

  form.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    erro.classList.add("hidden");

    if (!email.value.trim() || !senha.value) {
      mostrarErro("Preencha email e senha.");
      return;
    }

    botao.disabled = true;
    botao.textContent = "Entrando...";

    try {
      const resposta = await fetch("/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.value, senha: senha.value, lembrar: lembrar.checked }),
      });
      const corpo = await resposta.json().catch(() => ({}));
      if (resposta.ok && corpo.ok) {
        window.location.href = "/";
        return;
      }
      mostrarErro(corpo.message || "Nao foi possivel entrar.");
    } catch {
      mostrarErro("Falha de conexao. Tente novamente.");
    } finally {
      botao.disabled = false;
      botao.textContent = "Entrar";
    }
  });
</script>
</body>
</html>
