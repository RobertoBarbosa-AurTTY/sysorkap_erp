<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include("../../partials/head") %>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
  <%- include("../../partials/sidebar") %>
  <%- include("../../partials/tabbar") %>
  <div class="flex min-h-screen flex-col md:pl-72">
    <%- include("../../partials/topbar") %>
    <main class="flex-1 px-4 py-6 pb-28 sm:px-6 md:pb-10 lg:px-8">
      <div class="mb-6">
        <h2 class="text-xl font-bold tracking-tight text-white">Visão geral</h2>
        <p class="mt-0.5 text-sm text-zinc-400"><%= total %> produto<%= total === 1 ? "" : "s" %> cadastrado<%= total === 1 ? "" : "s" %></p>
      </div>

      <%
        const numero = new Intl.NumberFormat("pt-BR");
        const brl = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
        const cartoes = [
          { rotulo: "Valor de Venda em Estoque", valor: brl.format(resumo.valorVenda), icone: '<path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>', cor: "bg-primary/15 text-primary ring-primary/25" },
          { rotulo: "Produtos Parados", valor: numero.format(resumo.parados), icone: '<circle cx="12" cy="12" r="9"/><path d="M10 9.5v5l4-2.5z"/>', cor: "bg-red-500/15 text-red-400 ring-red-500/25" },
          { rotulo: "Produtos em Baixa", valor: numero.format(resumo.baixos), icone: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>', cor: "bg-amber-500/15 text-amber-400 ring-amber-500/25" },
          { rotulo: "Total de Itens", valor: numero.format(resumo.itens), icone: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>', cor: "bg-emerald-500/15 text-emerald-400 ring-emerald-500/25" },
        ];
      %>
      <div class="mb-6 grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4">
        <% cartoes.forEach((cartao) => { %>
          <div class="rounded-2xl border border-white/5 bg-zinc-900/60 p-4 transition-colors hover:border-white/10 sm:p-5">
            <div class="flex items-start justify-between gap-2">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500"><%= cartao.rotulo %></p>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg ring-1 ring-inset <%= cartao.cor %>">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><%- cartao.icone %></svg>
              </span>
            </div>
            <p class="mt-3 truncate text-xl font-bold tabular-nums text-white sm:text-2xl"><%= cartao.valor %></p>
          </div>
        <% }) %>
      </div>

      <% if (erro) { %>
        <div class="mb-4 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-300">
          Não foi possível carregar os produtos. Tente recarregar a página.
        </div>
      <% } %>

      <% if (typeof atualizado !== "undefined" && atualizado) { %>
        <div class="mb-4 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300">
          Produto atualizado com sucesso.
        </div>
      <% } %>

      <% if (typeof excluido !== "undefined" && excluido) { %>
        <div class="mb-4 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300">
          Produto excluído.
        </div>
      <% } %>

      <%
        const comFiltros = Boolean(filtros.busca || filtros.categoria || filtros.status);
        const linkPagina = (n) => {
          const p = new URLSearchParams();
          if (filtros.busca) p.set("q", filtros.busca);
          if (filtros.categoria) p.set("categoria", filtros.categoria);
          if (filtros.status) p.set("status", filtros.status);
          if (n > 1) p.set("pagina", String(n));
          const s = p.toString();
          return "/estoque" + (s ? "?" + s : "");
        };
        const classeCampo = "w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40";
      %>

      <form method="GET" action="/estoque" id="filtros" class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-center">
        <label class="relative block flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" name="q" value="<%= filtros.busca %>" placeholder="Digite nome, SKU ou fornecedor..." autocomplete="off"
            class="<%= classeCampo %> pl-10" />
        </label>
        <div class="flex gap-3 sm:max-lg:grid sm:max-lg:grid-cols-2">
          <select name="categoria" aria-label="Filtrar por categoria" class="<%= classeCampo %> cursor-pointer sm:w-48">
            <option value="">Todas as Categorias</option>
            <% categorias.forEach((cat) => { %>
              <option value="<%= cat %>" <%= filtros.categoria === cat ? "selected" : "" %>><%= cat %></option>
            <% }) %>
          </select>
          <select name="status" aria-label="Filtrar por status" class="<%= classeCampo %> cursor-pointer sm:w-40">
            <option value="">Todos os Status</option>
            <option value="ok" <%= filtros.status === "ok" ? "selected" : "" %>>OK</option>
            <option value="baixo" <%= filtros.status === "baixo" ? "selected" : "" %>>Baixo</option>
            <option value="esgotado" <%= filtros.status === "esgotado" ? "selected" : "" %>>Esgotado</option>
          </select>
        </div>
      </form>

      <% if (produtos.length === 0 && !erro) { %>
        <div class="rounded-2xl border border-dashed border-white/10 bg-zinc-900/40 px-6 py-16 text-center">
          <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-primary/15 text-primary ring-1 ring-inset ring-primary/25">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-white"><%= comFiltros ? "Nenhum produto encontrado" : "Nenhum produto cadastrado" %></h3>
          <p class="mt-1 text-sm text-zinc-400"><%= comFiltros ? "Tente ajustar a busca ou os filtros." : "Os produtos cadastrados na sua conta aparecem nesta tabela." %></p>
        </div>
      <% } else if (produtos.length > 0) { %>
        <div class="overflow-hidden rounded-2xl border border-white/5 bg-zinc-900/60">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm md:min-w-[880px]">
              <thead>
                <tr class="border-b border-white/5 text-[11px] uppercase tracking-wider text-zinc-500">
                  <th class="px-5 py-3.5 font-semibold">Imagem</th>
                  <th class="px-5 py-3.5 font-semibold">Produto</th>
                  <th class="hidden px-5 py-3.5 font-semibold md:table-cell">Categoria</th>
                  <th class="hidden px-5 py-3.5 font-semibold md:table-cell">Quantidade</th>
                  <th class="hidden px-5 py-3.5 font-semibold md:table-cell">R$ Venda</th>
                  <th class="hidden px-5 py-3.5 font-semibold md:table-cell">R$ Custo</th>
                  <th class="hidden px-5 py-3.5 font-semibold md:table-cell">Fornecedor</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <% produtos.forEach((produto) => {
                     const esgotado = produto.quantidadeAtual <= 0;
                     const baixo = !esgotado && produto.quantidadeAtual <= produto.quantidadeMinima;
                     const status = esgotado ? "Esgotado" : baixo ? "Baixo" : "OK";
                     const corPonto = esgotado ? "bg-red-400" : baixo ? "bg-amber-400" : "bg-emerald-400";
                %>
                  <tr class="cursor-pointer transition-colors hover:bg-white/[0.03]" onclick="abrirFicha('<%= produto._id %>')">
                    <td class="px-5 py-4">
                      <% if (produto.imagem) { %>
                        <img src="<%= produto.imagem %>" alt="<%= produto.nome %>" loading="lazy"
                          class="h-12 w-12 rounded-lg object-cover ring-1 ring-inset ring-white/10" />
                      <% } else { %>
                        <span class="grid h-12 w-12 place-items-center rounded-lg bg-zinc-800 text-zinc-600 ring-1 ring-inset ring-white/5">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                        </span>
                      <% } %>
                    </td>
                    <td class="px-5 py-4">
                      <p class="font-medium text-white"><%= produto.nome %></p>
                      <p class="mt-0.5 text-xs text-zinc-500">SKU <%= produto.sku %></p>
                    </td>
                    <td class="hidden px-5 py-4 text-zinc-300 md:table-cell"><%= produto.categoria || "—" %></td>
                    <td class="hidden px-5 py-4 tabular-nums text-zinc-300 md:table-cell">
                      <span class="inline-flex items-center gap-2" title="<%= status %>">
                        <span class="h-1.5 w-1.5 rounded-full <%= corPonto %>"></span>
                        <%= produto.quantidadeAtual %> <span class="text-xs text-zinc-500"><%= produto.unidade %></span>
                      </span>
                    </td>
                    <td class="hidden px-5 py-4 tabular-nums text-zinc-300 md:table-cell"><%= brl.format(produto.precoVenda) %></td>
                    <td class="hidden px-5 py-4 tabular-nums text-zinc-300 md:table-cell"><%= brl.format(produto.precoCusto) %></td>
                    <td class="hidden px-5 py-4 text-zinc-300 md:table-cell"><%= produto.fornecedor || "—" %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <% if (!erro && totalPaginas > 1) { %>
        <%
          const numeros = [];
          if (totalPaginas <= 7) {
            for (let i = 1; i <= totalPaginas; i++) numeros.push(i);
          } else {
            numeros.push(1);
            const ini = Math.max(2, pagina - 1);
            const fim = Math.min(totalPaginas - 1, pagina + 1);
            if (ini > 2) numeros.push("…");
            for (let i = ini; i <= fim; i++) numeros.push(i);
            if (fim < totalPaginas - 1) numeros.push("…");
            numeros.push(totalPaginas);
          }
          const classeBase = "grid h-9 min-w-9 place-items-center rounded-lg px-2 text-sm font-medium transition-colors";
        %>
        <nav class="mt-4 flex items-center justify-between" aria-label="Paginação da tabela">
          <p class="text-xs text-zinc-500">Página <%= pagina %> de <%= totalPaginas %></p>
          <div class="flex items-center gap-1">
            <% if (pagina > 1) { %>
              <a href="<%= linkPagina(pagina - 1) %>" aria-label="Página anterior" class="<%= classeBase %> text-zinc-400 hover:bg-white/5 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m15 18-6-6 6-6"/></svg>
              </a>
            <% } %>
            <% numeros.forEach((n) => { if (typeof n === "string") { %>
              <span class="<%= classeBase %> cursor-default text-zinc-600"><%= n %></span>
            <% } else if (n === pagina) { %>
              <span aria-current="page" class="<%= classeBase %> bg-primary text-white shadow-lg shadow-primary/25"><%= n %></span>
            <% } else { %>
              <a href="<%= linkPagina(n) %>" class="<%= classeBase %> text-zinc-400 hover:bg-white/5 hover:text-white"><%= n %></a>
            <% } }) %>
            <% if (pagina < totalPaginas) { %>
              <a href="<%= linkPagina(pagina + 1) %>" aria-label="Próxima página" class="<%= classeBase %> text-zinc-400 hover:bg-white/5 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            <% } %>
          </div>
        </nav>
      <% } %>

      <script>
        (() => {
          const form = document.getElementById("filtros");
          const busca = form.querySelector("input[name=q]");
          let timer;
          form.querySelectorAll("select").forEach((el) => el.addEventListener("change", () => form.submit()));
          busca.addEventListener("input", () => {
            clearTimeout(timer);
            timer = setTimeout(() => form.submit(), 450);
          });
          <% if (filtros.busca) { %>
          busca.focus();
          busca.setSelectionRange(busca.value.length, busca.value.length);
          <% } %>
        })();
      </script>
      <script type="application/json" id="dados-produtos"><%- JSON.stringify(produtos.map((p) => ({ _id: String(p._id), nome: p.nome, sku: p.sku, codigoBarras: p.codigoBarras, categoria: p.categoria, fornecedor: p.fornecedor, imagem: p.imagem, unidade: p.unidade, estante: p.estante, nivel: p.nivel, apto: p.apto, precoCusto: p.precoCusto, precoVenda: p.precoVenda, quantidadeAtual: p.quantidadeAtual, quantidadeMinima: p.quantidadeMinima, criadoEm: p.createdAt, atualizadoEm: p.updatedAt }))).replace(/</g, "\\u003c") %></script>

      <div id="ficha-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
        <div id="ficha-modal" role="dialog" aria-modal="true" class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl border border-white/10 bg-zinc-900 shadow-2xl"></div>
      </div>

      <script>
        (() => {
          const dados = JSON.parse(document.getElementById("dados-produtos").textContent);
          const overlay = document.getElementById("ficha-overlay");
          const modal = document.getElementById("ficha-modal");
          const fmt = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
          const esc = (s) =>
            String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

          window.abrirFicha = (id) => {
            const p = dados.find((x) => x._id === id);
            if (!p) return;
            const esgotado = p.quantidadeAtual <= 0;
            const baixo = !esgotado && p.quantidadeAtual <= p.quantidadeMinima;
            const st = esgotado
              ? ["Esgotado", "bg-red-400", "bg-red-500/10 text-red-300 ring-red-500/25", "bg-red-500"]
              : baixo
                ? ["Baixo", "bg-amber-400", "bg-amber-500/10 text-amber-300 ring-amber-500/25", "bg-amber-500"]
                : ["OK", "bg-emerald-400", "bg-emerald-500/10 text-emerald-300 ring-emerald-500/25", "bg-emerald-500"];
            const lucroUnit = p.precoVenda - p.precoCusto;
            const investimento = p.precoCusto * p.quantidadeAtual;
            const valorVendaTotal = p.precoVenda * p.quantidadeAtual;
            const margem = p.precoVenda > 0 ? (lucroUnit / p.precoVenda) * 100 : 0;
            const pctBarra = p.quantidadeMinima > 0 ? Math.min(100, (p.quantidadeAtual / p.quantidadeMinima) * 100) : 100;
            const fmtPct = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 1 });
            const fmtData = (iso) => {
              if (!iso) return "—";
              const d = new Date(iso);
              const hh = String(d.getHours()).padStart(2, "0");
              const mm = String(d.getMinutes()).padStart(2, "0");
              return `${d.toLocaleDateString("pt-BR")} às ${hh}:${mm}`;
            };
            const campo = (rotulo, valor) =>
              `<div><dt class="text-xs uppercase tracking-wider text-zinc-500">${rotulo}</dt><dd class="mt-1 text-sm font-medium text-zinc-100">${valor}</dd></div>`;
            const kpi = (icone, rotulo, valor, classes) => `
              <div class="rounded-xl px-3 py-2.5 ring-1 ring-inset ${classes}">
                <div class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider opacity-80">${icone}<span class="truncate">${rotulo}</span></div>
                <p class="mt-1.5 truncate text-sm font-bold tabular-nums text-white sm:text-base" title="${valor}">${valor}</p>
              </div>`;
            const iconeCaixa = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 shrink-0"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`;
            const iconeLucro = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 shrink-0"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>`;
            const iconeMargem = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 shrink-0"><line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>`;
            const secao = (titulo, conteudo) => `
              <section>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">${titulo}</p>
                ${conteudo}
              </section>`;
            const caixaLocal = (rotulo, valor) =>
              valor
                ? `<div class="rounded-lg bg-zinc-950 px-3 py-2 ring-1 ring-inset ring-white/10">
                     <p class="text-[10px] font-semibold uppercase tracking-wider text-zinc-500">${rotulo}</p>
                     <p class="mt-0.5 truncate font-mono text-sm font-semibold text-zinc-100">${esc(valor)}</p>
                   </div>`
                : "";
            const temLocal = p.estante || p.nivel || p.apto;
            const foto = p.imagem
              ? `<img src="${esc(p.imagem)}" alt="${esc(p.nome)}" class="h-16 w-16 shrink-0 rounded-xl object-cover ring-1 ring-inset ring-white/10" />`
              : `<span class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-zinc-800 text-zinc-600 ring-1 ring-inset ring-white/5">
                   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                 </span>`;
            modal.innerHTML = `
              <div class="flex items-start gap-4 border-b border-white/5 p-5">
                ${foto}
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold leading-snug tracking-tight text-white">${esc(p.nome)}</h3>
                  <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="rounded-md bg-zinc-800 px-2 py-0.5 font-mono text-xs text-zinc-300">#${esc(p.sku)}</span>
                    <span class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${st[2]}">
                      <span class="h-1.5 w-1.5 rounded-full ${st[1]}"></span>${st[0]}
                    </span>
                  </div>
                </div>
                <button type="button" onclick="fecharFicha()" aria-label="Fechar ficha do produto" class="grid h-8 w-8 shrink-0 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-white/5 hover:text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
              </div>

              <div class="space-y-5 p-5">
                ${secao(
                  "Informações",
                  `<dl class="grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-4">
                    ${campo("SKU", `#${esc(p.sku)}`)}
                    ${campo("Código de Barras", esc(p.codigoBarras) || "—")}
                    ${campo("Data de Entrada", fmtData(p.criadoEm))}
                    ${campo("Última Atualização", fmtData(p.atualizadoEm))}
                  </dl>`,
                )}

                ${p.categoria || temLocal ? secao(
                  "Organização",
                  `<div class="flex flex-wrap items-center gap-2">
                    ${p.categoria ? `<span class="rounded-md bg-sky-500/10 px-2 py-0.5 text-xs font-medium text-sky-300 ring-1 ring-inset ring-sky-500/25">${esc(p.categoria)}</span>` : ""}
                    ${p.fornecedor ? `<span class="rounded-md bg-zinc-800 px-2 py-0.5 text-xs text-zinc-300">${esc(p.fornecedor)}</span>` : ""}
                  </div>
                  ${temLocal ? `<div class="mt-2 grid grid-cols-3 gap-2">${caixaLocal("Estante", p.estante)}${caixaLocal("Nível", p.nivel)}${caixaLocal("Apto", p.apto)}</div>` : ""}`,
                ) : ""}

                ${secao(
                  "Performance de Vendas",
                  `<dl class="grid grid-cols-3 gap-x-4 gap-y-4">
                    ${campo("Total vendido", "—")}
                    ${campo("Lucro estimado", "—")}
                    ${campo("Última movimentação", "—")}
                  </dl>
                  <p class="mt-2 text-xs text-zinc-600">Disponível após registrar saídas de venda.</p>`,
                )}

                ${secao(
                  "Margens e Investimento",
                  `<div class="grid grid-cols-3 gap-2">
                    ${kpi(iconeLucro, "Lucro unitário", fmt.format(lucroUnit), lucroUnit >= 0 ? "bg-emerald-500/10 text-emerald-400 ring-emerald-500/25" : "bg-red-500/10 text-red-400 ring-red-500/25")}
                    ${kpi(iconeMargem, "Margem de lucro", `${fmtPct.format(margem)}%`, "bg-violet-500/10 text-violet-400 ring-violet-500/25")}
                    ${kpi(iconeCaixa, "Investimento total", fmt.format(investimento), "bg-amber-500/10 text-amber-400 ring-amber-500/25")}
                  </div>`,
                )}

                ${secao(
                  "Disponível",
                  `<div class="flex items-end justify-between gap-4">
                    <div>
                      <p class="text-xs text-zinc-400">Total físico</p>
                      <p class="text-2xl font-bold tabular-nums text-white">${p.quantidadeAtual} <span class="text-sm font-normal text-zinc-500">${esc(p.unidade)}</span></p>
                    </div>
                    <div class="text-right">
                      <p class="text-xs text-zinc-400">Valor em estoque (venda)</p>
                      <p class="text-base font-bold tabular-nums text-emerald-300">${fmt.format(valorVendaTotal)}</p>
                    </div>
                  </div>
                  <div class="mt-3 h-2 overflow-hidden rounded-full bg-zinc-800">
                    <div class="h-full rounded-full transition-all duration-500 ${st[1]}" style="width: ${esgotado ? 100 : pctBarra}%"></div>
                  </div>
                  <p class="mt-1.5 text-xs text-zinc-500">Quantidade mínima: ${p.quantidadeMinima} ${esc(p.unidade)}</p>`,
                )}
              </div>

              <div class="flex items-center justify-between gap-3 border-t border-white/5 p-5">
                <form method="POST" action="/estoque/${p._id}/excluir" onsubmit="return confirm('Excluir &quot;${esc(p.nome)}&quot;? Essa ação não pode ser desfeita.')">
                  <button type="submit" class="inline-flex items-center gap-2 rounded-xl border border-red-500/30 px-4 py-2.5 text-sm font-medium text-red-300 transition-colors hover:bg-red-500/10">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Excluir
                  </button>
                </form>
                <a href="/estoque/${p._id}/editar" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-transform hover:scale-[1.02] active:scale-[0.98]">
                  Editar
                </a>
              </div>`;
            overlay.classList.remove("hidden");
            overlay.classList.add("flex");
            document.body.style.overflow = "hidden";
          };

          window.fecharFicha = () => {
            overlay.classList.add("hidden");
            overlay.classList.remove("flex");
            document.body.style.overflow = "";
          };

          overlay.addEventListener("click", (e) => {
            if (e.target === overlay) fecharFicha();
          });
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") fecharFicha();
          });
        })();
      </script>
    </main>
  </div>
</body>
</html>
