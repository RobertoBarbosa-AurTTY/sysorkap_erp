<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include("../../partials/head") %>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
  <%- include("../../partials/sidebar") %>
  <%- include("../../partials/tabbar") %>
  <div class="flex min-h-screen flex-col md:pl-72">
    <%- include("../../partials/topbar") %>
    <main class="flex-1 px-4 py-6 pb-28 sm:px-6 md:pb-10 lg:px-8">
      <div class="mb-6">
        <h2 class="text-xl font-bold tracking-tight text-white"><%= typeof cabecalho !== "undefined" ? cabecalho : "Novo produto" %></h2>
        <p class="mt-0.5 text-sm text-zinc-400"><%= typeof descricao !== "undefined" ? descricao : "Cadastre um produto no estoque da sua conta." %></p>
      </div>

      <% if (typeof erros !== "undefined" && erros.length > 0) { %>
        <div class="mb-5 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-300">
          <ul class="list-inside list-disc space-y-0.5">
            <% erros.forEach((erro) => { %><li><%= erro %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <%
        const valor = (campo, padrao = "") => {
          if (typeof valores === "undefined" || !valores || typeof valores[campo] === "undefined") return padrao;
          return String(valores[campo]);
        };
        const unidades = ["un", "cx", "kg", "g", "L", "ml", "m"];
      %>

      <form method="POST" action="<%= typeof acao !== "undefined" && acao ? acao : "/estoque" %>" class="max-w-2xl rounded-2xl border border-white/5 bg-zinc-900/60 p-5 sm:p-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Nome *</span>
            <input type="text" name="nome" required minlength="2" value="<%= valor("nome") %>" placeholder="Ex.: Teclado mecânico"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">SKU *</span>
            <input type="text" name="sku" required value="<%= valor("sku") %>" placeholder="Ex.: TEC-001"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm uppercase text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Código de barras</span>
            <input type="text" name="codigoBarras" value="<%= valor("codigoBarras") %>" placeholder="Ex.: 0751320412041"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm tabular-nums text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Categoria</span>
            <input type="text" name="categoria" value="<%= valor("categoria") %>" placeholder="Ex.: Periféricos"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Fornecedor</span>
            <input type="text" name="fornecedor" value="<%= valor("fornecedor") %>" placeholder="Ex.: TechDistribuidora"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Unidade</span>
            <select name="unidade"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40">
              <% unidades.forEach((u) => { %>
                <option value="<%= u %>" <%= valor("unidade", "un") === u ? "selected" : "" %>><%= u %></option>
              <% }) %>
            </select>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Quantidade mínima</span>
            <input type="number" name="quantidadeMinima" min="0" step="any" value="<%= valor("quantidadeMinima", "0") %>"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm tabular-nums text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
            <span class="mt-1 block text-xs text-zinc-500">Abaixo disso o produto aparece como "Baixo".</span>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Preço de custo (R$)</span>
            <input type="number" name="precoCusto" min="0" step="0.01" value="<%= valor("precoCusto", "0") %>"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm tabular-nums text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Preço de venda (R$)</span>
            <input type="number" name="precoVenda" min="0" step="0.01" value="<%= valor("precoVenda", "0") %>"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm tabular-nums text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block sm:col-span-2">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Quantidade em estoque</span>
            <input type="number" name="quantidadeAtual" min="0" step="any" value="<%= valor("quantidadeAtual", "0") %>"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm tabular-nums text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
          </label>

          <label class="block sm:col-span-2">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Localização no armazém</span>
            <div class="grid grid-cols-3 gap-3">
              <input type="text" name="estante" value="<%= valor("estante") %>" placeholder="Estante"
                class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm uppercase text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
              <input type="text" name="nivel" value="<%= valor("nivel") %>" placeholder="Nível"
                class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm uppercase text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
              <input type="text" name="apto" value="<%= valor("apto") %>" placeholder="Apto"
                class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm uppercase text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
            </div>
            <span class="mt-1 block text-xs text-zinc-500">Opcional — onde o produto fica guardado.</span>
          </label>

          <label class="block sm:col-span-2">
            <span class="mb-1.5 block text-sm font-medium text-zinc-300">Imagem (URL)</span>
            <input type="url" name="imagem" value="<%= valor("imagem") %>" placeholder="https://exemplo.com/foto.jpg"
              class="w-full rounded-xl border border-white/10 bg-zinc-950 px-3.5 py-2.5 text-sm text-white placeholder:text-zinc-600 transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
            <span class="mt-1 block text-xs text-zinc-500">Opcional — aparece na tabela do estoque.</span>
          </label>
        </div>

        <div class="mt-6 flex items-center justify-end gap-3 border-t border-white/5 pt-5">
          <a href="/estoque" class="rounded-xl px-4 py-2.5 text-sm font-medium text-zinc-400 transition-colors hover:bg-white/5 hover:text-white">Cancelar</a>
          <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-transform hover:scale-[1.02] active:scale-[0.98]">
            Salvar produto
          </button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
