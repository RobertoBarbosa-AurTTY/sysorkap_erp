<aside class="hidden md:flex fixed inset-y-0 left-0 z-30 w-72 flex-col border-r border-white/5 bg-zinc-950">
  <div class="flex h-16 items-center gap-3 border-b border-white/5 px-5">
    <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-primary to-primary-dark text-white shadow-lg shadow-primary/25">
      <%- nav.icones.marca %>
    </div>
    <div class="min-w-0">
      <p class="truncate text-[15px] font-semibold leading-tight tracking-tight text-white">Sysorkap</p>
      <p class="text-[11px] leading-tight text-zinc-500">Gestão de estoque</p>
    </div>
  </div>

  <nav class="flex-1 space-y-5 overflow-y-auto px-3 py-5">
    <% nav.secoes.forEach((secao) => { %>
      <div>
        <p class="px-3 pb-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600"><%= secao.label %></p>
        <div class="space-y-0.5">
          <% secao.itens.forEach((item) => {
               const ativo = nav.rotaAtiva(item.href);
               const aberto = Boolean(item.filhos && ativo);
          %>
            <% if (item.filhos) { %>
              <button
                type="button"
                data-alternar="submenu-<%= item.key %>"
                aria-expanded="<%= aberto %>"
                aria-controls="submenu-<%= item.key %>"
                class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-all duration-200 <%= ativo ? 'bg-primary/15 text-white ring-1 ring-inset ring-primary/25' : 'text-zinc-400 hover:bg-white/5 hover:text-white' %>"
              >
                <span class="shrink-0 transition-colors duration-200 <%= ativo ? 'text-primary' : 'text-zinc-500 group-hover:text-zinc-300' %>"><%- item.icone %></span>
                <span class="flex-1 text-left"><%= item.nome %></span>
                <svg data-seta xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-zinc-600 transition-transform duration-300 <%= aberto ? 'rotate-180' : '' %>"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="submenu-<%= item.key %>" class="grid transition-[grid-template-rows] duration-300 ease-out <%= aberto ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]' %>">
                <div class="overflow-hidden">
                  <div class="ml-[22px] mt-1 space-y-0.5 border-l border-white/[0.06] py-1 pl-3">
                    <% item.filhos.forEach((filho) => { const filhoAtivo = nav.rotaAtiva(filho.href, true); %>
                      <a
                        href="<%= filho.href %>"
                        aria-current="<%= filhoAtivo ? 'page' : undefined %>"
                        class="group/sub flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] transition-all duration-200 <%= filhoAtivo ? 'bg-white/[0.06] font-medium text-white' : 'text-zinc-500 hover:bg-white/[0.04] hover:text-zinc-200' %>"
                      >
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full transition-all duration-200 <%= filhoAtivo ? 'scale-110 bg-primary shadow-[0_0_8px] shadow-primary/60' : 'bg-zinc-700 group-hover/sub:bg-zinc-500' %>"></span>
                        <%= filho.nome %>
                      </a>
                    <% }) %>
                  </div>
                </div>
              </div>
            <% } else { %>
              <a
                href="<%= item.href %>"
                aria-current="<%= ativo ? 'page' : undefined %>"
                class="group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-all duration-200 <%= ativo ? 'bg-gradient-to-r from-primary/20 to-primary/[0.07] text-white ring-1 ring-inset ring-primary/30 shadow-lg shadow-primary/10' : 'text-zinc-400 hover:bg-white/5 hover:text-white' %>"
              >
                <span class="shrink-0 transition-colors duration-200 <%= ativo ? 'text-primary' : 'text-zinc-500 group-hover:text-zinc-300' %>"><%- item.icone %></span>
                <%= item.nome %>
              </a>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </nav>

  <div class="border-t border-white/5 p-3">
    <div class="flex items-center gap-3 rounded-xl bg-white/[0.03] px-3 py-2.5 ring-1 ring-inset ring-white/5">
      <div class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-primary to-primary-dark text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="truncate text-xs font-medium text-white">Minha conta</p>
        <p class="flex items-center gap-1.5 text-[10px] text-emerald-400">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>Online
        </p>
      </div>
      <form method="POST" action="/logout">
        <button type="submit" title="Sair da conta" class="grid h-8 w-8 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-red-500/10 hover:text-red-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
        </button>
      </form>
    </div>
  </div>
</aside>

<script>
  (() => {
    const botoes = document.querySelectorAll("[data-alternar]");
    botoes.forEach((botao) => {
      botao.addEventListener("click", () => {
        const painel = document.getElementById(botao.dataset.alternar);
        const vaiAbrir = !painel.classList.contains("grid-rows-[1fr]");
        botoes.forEach((outro) => {
          if (outro === botao) return;
          document.getElementById(outro.dataset.alternar)?.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
          outro.setAttribute("aria-expanded", "false");
          outro.querySelector("[data-seta]")?.classList.remove("rotate-180");
        });
        painel.classList.toggle("grid-rows-[1fr]", vaiAbrir);
        painel.classList.toggle("grid-rows-[0fr]", !vaiAbrir);
        botao.setAttribute("aria-expanded", String(vaiAbrir));
        botao.querySelector("[data-seta]")?.classList.toggle("rotate-180", vaiAbrir);
      });
    });
  })();
</script>
