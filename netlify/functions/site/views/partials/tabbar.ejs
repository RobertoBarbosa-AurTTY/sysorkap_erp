<nav class="md:hidden fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-zinc-950/90 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl">
  <div class="mx-auto grid h-16 max-w-md grid-cols-5">
    <% const abas = [
         { nome: "Início", href: "/", icone: nav.icones.dashboard },
         { nome: "Estoque", href: "/estoque", icone: nav.icones.estoque },
         { nome: "Saídas", href: "/saidas", icone: nav.icones.saidas },
         { nome: "Clientes", href: "/clientes", icone: nav.icones.clientes },
       ]; %>
    <% abas.forEach((aba) => { const ativa = nav.rotaAtiva(aba.href); %>
      <a href="<%= aba.href %>" aria-current="<%= ativa ? 'page' : undefined %>" class="relative flex flex-col items-center justify-center gap-1">
        <span class="absolute -top-px h-0.5 w-9 rounded-full bg-primary transition-opacity duration-300 <%= ativa ? 'opacity-100' : 'opacity-0' %>"></span>
        <span class="grid h-7 w-12 place-items-center rounded-full transition-all duration-300 <%= ativa ? 'scale-105 bg-primary/15 text-primary' : 'text-zinc-500' %>"><%- aba.icone %></span>
        <span class="text-[10px] font-medium <%= ativa ? 'text-primary' : 'text-zinc-500' %>"><%= aba.nome %></span>
      </a>
    <% }) %>
    <button type="button" id="abrir-menu" aria-expanded="false" aria-controls="menu-sheet" aria-label="Abrir menu completo" class="relative flex flex-col items-center justify-center gap-1">
      <span class="grid h-7 w-12 place-items-center rounded-full text-zinc-500 transition-colors active:bg-white/10"><%- nav.icones.mais %></span>
      <span class="text-[10px] font-medium text-zinc-500">Mais</span>
    </button>
  </div>
</nav>

<div id="menu-sheet" class="pointer-events-none fixed inset-0 z-50 md:hidden" aria-hidden="true">
  <div data-fechar class="absolute inset-0 bg-black/70 opacity-0 backdrop-blur-sm transition-opacity duration-300"></div>
  <div data-painel class="absolute inset-x-0 bottom-0 translate-y-full rounded-t-3xl border-t border-white/10 bg-zinc-900 transition-transform duration-300 ease-spring">
    <div class="mx-auto mt-3 h-1 w-10 rounded-full bg-zinc-700"></div>
    <div class="flex items-center justify-between px-5 pb-1 pt-3">
      <p class="text-sm font-semibold text-white">Menu</p>
      <button type="button" data-fechar aria-label="Fechar menu" class="grid h-9 w-9 place-items-center rounded-full text-zinc-400 transition-colors hover:bg-white/10 hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="max-h-[65vh] space-y-4 overflow-y-auto px-3 pb-[calc(env(safe-area-inset-bottom)+1.25rem)] pt-1">
      <% nav.secoes.forEach((secao) => { %>
        <div>
          <p class="px-3 pb-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-600"><%= secao.label %></p>
          <div class="space-y-0.5">
            <% secao.itens.forEach((item) => {
                 const links = item.filhos ?? [{ nome: item.nome, href: item.href }];
            %>
              <% links.forEach((link) => { const ativo = nav.rotaAtiva(link.href); %>
                <a
                  href="<%= link.href %>"
                  class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors <%= ativo ? 'bg-primary/15 font-medium text-white ring-1 ring-inset ring-primary/25' : 'text-zinc-400 hover:bg-white/5 hover:text-white' %>"
                >
                  <% if (link === item) { %>
                    <span class="shrink-0 <%= ativo ? 'text-primary' : 'text-zinc-500' %>"><%- item.icone %></span>
                  <% } else { %>
                    <span class="grid w-5 shrink-0 place-items-center"><span class="h-1.5 w-1.5 rounded-full <%= ativo ? 'bg-primary' : 'bg-zinc-700' %>"></span></span>
                  <% } %>
                  <%= link.nome %>
                </a>
              <% }) %>
            <% }) %>
          </div>
        </div>
      <% }) %>
      <form method="POST" action="/logout" class="pt-1">
        <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl border border-red-500/20 bg-red-500/10 px-3 py-3 text-sm font-medium text-red-400 transition-colors hover:bg-red-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
          Sair da conta
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  (() => {
    const raiz = document.getElementById("menu-sheet");
    const fundo = raiz.querySelector("[data-fechar]");
    const painel = raiz.querySelector("[data-painel]");
    const botao = document.getElementById("abrir-menu");
    let aberto = false;

    function alternar(estado) {
      aberto = estado;
      raiz.classList.toggle("pointer-events-none", !aberto);
      raiz.setAttribute("aria-hidden", String(!aberto));
      botao.setAttribute("aria-expanded", String(aberto));
      document.documentElement.classList.toggle("overflow-hidden", aberto);
      fundo.classList.toggle("opacity-100", aberto);
      fundo.classList.toggle("opacity-0", !aberto);
      painel.classList.toggle("translate-y-0", aberto);
      painel.classList.toggle("translate-y-full", !aberto);
    }

    botao.addEventListener("click", () => alternar(true));
    raiz.querySelectorAll("[data-fechar]").forEach((el) => el.addEventListener("click", () => alternar(false)));
    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape") alternar(false);
    });
  })();
</script>
