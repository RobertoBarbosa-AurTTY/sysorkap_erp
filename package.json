{
  "name": "sysorkap-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && netlify dev",
    "routes:generate": "node scripts/generate-routes.ts",
    "css": "tailwindcss -i css/tailwind.css -o public/css/tailwind.css --watch",
    "css:build": "tailwindcss -i css/tailwind.css -o public/css/tailwind.css --minify",
    "typecheck": "tsc --noEmit",
    "db:create": "node scripts/db-create.ts",
    "seed:usuarios": "node scripts/seed-usuarios.ts",
    "hash-password": "node scripts/hash-password.ts",
    "build": "npm run routes:generate && npm run css:build && npm run typecheck",
    "deploy": "netlify deploy --prod"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/ejs": "^3.1.0",
    "@types/express": "^4.17.0",
    "@types/node": "^26.2.0",
    "netlify-cli": "^17.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ejs": "^3.1.0",
    "express": "^4.19.0",
    "mongoose": "^9.9.3",
    "serverless-http": "^4.0.0"
  }
}
